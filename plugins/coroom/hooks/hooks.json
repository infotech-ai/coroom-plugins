{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin-sh/coroom-wake.sh\" --host claude",
            "async": true,
            "asyncRewake": true,
            "timeout": 3900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*coroom_room_join",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin-sh/coroom-local-note.sh\" --host claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*coroom_(room_join|whoami|get_updates)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin-sh/coroom-wake.sh\" --save",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin-sh/coroom-turn-note.sh\" --host claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
