{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin-sh/coroom-wake.sh\" --host codex",
            "timeout": 3900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*coroom_room_join",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin-sh/coroom-local-note.sh\" --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
